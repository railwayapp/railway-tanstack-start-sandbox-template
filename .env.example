# Local development. On Railway these are service variables (see README).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dispatch

# Access password for the app and the API. Leave unset locally to run open.
DISPATCH_PASSWORD=
# Encrypts the session cookie (32+ characters).
SESSION_SECRET=change-me-to-a-random-string-of-32-chars

# Runs: Claude Code's key, and a Railway token + environment for sandboxes.
ANTHROPIC_API_KEY=
RAILWAY_API_TOKEN=
RAILWAY_ENVIRONMENT_ID=

# Optional: the model Claude Code uses (default: sonnet).
DISPATCH_MODEL=
