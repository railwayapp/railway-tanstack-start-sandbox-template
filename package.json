{
  "name": "railway-tanstack-start-sandbox-template",
  "description": "Dispatch: a TanStack Start work tracker where an AI agent runs each task in a Railway sandbox.",
  "repository": {
    "type": "git",
    "url": "https://github.com/railwayapp/railway-tanstack-start-sandbox-template"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tanstack/ai": "^0.65.1",
    "@tanstack/ai-anthropic": "^0.19.5",
    "@tanstack/ai-claude-code": "^0.7.3",
    "@tanstack/ai-sandbox": "^0.5.19",
    "@tanstack/ai-sandbox-railway": "^0.1.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "nitro": "3.0.260903-beta",
    "railway": "^3.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
