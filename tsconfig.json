{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
        "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts", "drizzle.config.ts"]
}
